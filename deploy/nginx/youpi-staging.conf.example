# YOUPI PG V2 — staging Nginx virtual hosts (host-level, not a container).
#
# This sample is HTTP-first so `certbot --nginx` can complete the ACME challenge
# and add `listen 443 ssl` + certificate paths in place. Do not leave port 80 as
# the public payment entrypoint; run the certbot command below before going live.
#
#   sudo cp deploy/nginx/youpi-staging.conf.example /etc/nginx/sites-available/youpi-staging
#   sudo sed -i 's/staging\.example\.com/your-real-domain/g' /etc/nginx/sites-available/youpi-staging
#   sudo ln -s /etc/nginx/sites-available/youpi-staging /etc/nginx/sites-enabled/youpi-staging
#   sudo mkdir -p /var/www/html
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d pay.your-real-domain -d pay-api.your-real-domain
#   sudo nginx -t && sudo systemctl reload nginx
#
# certbot adds the equivalent of these directives to each server block:
#   listen 443 ssl;  ssl_certificate .../fullchain.pem;  ssl_certificate_key .../privkey.pem;
# and a port-80 -> HTTPS redirect. Keep the proxy_set_header lines below intact.
#
# Nothing here touches other vhosts. Admin (6001) is intentionally NOT proxied:
# use `ssh -L 6001:127.0.0.1:6001 user@vps` and open http://127.0.0.1:6001.

upstream youpi_checkout { server 127.0.0.1:7000; keepalive 16; }
upstream youpi_api      { server 127.0.0.1:6100; keepalive 16; }

# ------------------------------------------------------------
# Checkout host: customer pages, SDK, checkout API proxy
# ------------------------------------------------------------
server {
    listen 80;
    server_name pay.staging.example.com;

    location /.well-known/acme-challenge/ { root /var/www/html; }

    client_max_body_size 2m;

    # Admin and observer surfaces are never reachable from the public checkout host.
    location ^~ /api/v1/admin/      { return 404; }
    location ^~ /api/v1/pollers/    { return 404; }
    location ^~ /api/v1/observers/  { return 404; }

    location = /health {
        proxy_pass http://youpi_checkout;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /checkout/ {
        proxy_pass http://youpi_checkout;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /icons/ {
        proxy_pass http://youpi_checkout;
        proxy_set_header Host $host;
    }

    location = /youpi.js {
        proxy_pass http://youpi_checkout;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /sdk/ {
        proxy_pass http://youpi_checkout;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Transparent checkout -> payment API proxy (checkout token still required).
    # Developer evidence-injection tooling is never reachable publicly.
    location ^~ /api/ {
        if ($uri ~ ^/api/v1/checkout/[^/]+/simulate-observation$) { return 404; }
        proxy_pass http://youpi_checkout;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;          # SSE status stream
        proxy_read_timeout 3600s;
    }

    location / { return 404; }
}

# ------------------------------------------------------------
# API host: signed Android observer + merchant server API
# ------------------------------------------------------------
server {
    listen 80;
    server_name pay-api.staging.example.com;

    location /.well-known/acme-challenge/ { root /var/www/html; }

    client_max_body_size 1m;

    location = /health {
        proxy_pass http://youpi_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/v1/health {
        proxy_pass http://youpi_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Merchant server-to-server payment creation (credential required).
    location = /api/v1/payments {
        proxy_pass http://youpi_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Merchant payment-status polling (merchant key or scoped checkout token).
    location ~ ^/api/v1/payments/[A-Za-z0-9-]+$ {
        proxy_pass http://youpi_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/v1/checkout/ {
        if ($uri ~ ^/api/v1/checkout/[^/]+/simulate-observation$) { return 404; }
        proxy_pass http://youpi_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # Android APK: /pair, /events, /heartbeat, /active-window, /observers/*.
    location ^~ /api/v1/pollers/ {
        proxy_pass http://youpi_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/v1/observers/ {
        proxy_pass http://youpi_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Explicit deny: admin, devices, customers, webhooks, and everything else.
    location / { return 404; }
}
