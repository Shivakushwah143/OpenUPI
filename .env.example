[TEMPLATE]
# ============================================================
# OpenUPI — Environment Configuration Template
# ============================================================
# Copy this file to `.env` and fill in real values for your deployment.
# NEVER commit `.env` (or any real secret) to version control.
#
# Legend (tags are written as trailing comments so the file stays valid .env):
#   [REQUIRED]        the service fails closed when this is missing.
#   [OPTIONAL]        a safe default exists; override only when needed.
#   [PRODUCTION ONLY]  additionally enforced when NODE_ENV=production.
#
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================
#
# Docker/VPS staging: use `.env.staging.example` with `docker-compose.staging.yml`
# instead of this file.

# --- RUNTIME ---
# development | test | production
NODE_ENV=development
# localhost (single host) | server (deployment behind a reverse proxy/tunnel)
YOUPI_MODE=localhost

# --- SERVICE PORTS (single-host topology) ---
CONTROL_CENTER_PORT=8090            # [OPTIONAL]
PAYMENT_API_PORT=6100               # [OPTIONAL]
CHECKOUT_PORTAL_PORT=7000           # [OPTIONAL]
MERCHANT_ADMIN_PORT=6001            # [OPTIONAL]
HELP_PORTAL_PORT=3000               # [OPTIONAL]
GMAIL_OBSERVER_PORT=6003            # [OPTIONAL]
SMS_OBSERVER_PORT=6002              # [OPTIONAL]
COIN_STORE_PORT=5000                # [OPTIONAL]

# --- INTERNAL / PUBLIC URLS ---
BASE_PAYMENT_API_URL=http://localhost:6100   # [OPTIONAL]
BASE_CHECKOUT_URL=http://localhost:7000     # [OPTIONAL]
PAYMENT_API_INTERNAL_URL=http://127.0.0.1:6100   # [OPTIONAL]

# --- STORAGE ---
SQLITE_DB_PATH=./data/openupi.sqlite        # [OPTIONAL]
DEV_DB_PATH=./data/openupi-dev.sqlite       # [OPTIONAL]
# Only set to true to intentionally rebuild a legacy/incompatible schema.
# This DESTROYS customer identity tables — back up first.
ALLOW_DESTRUCTIVE_MIGRATION=false           # [OPTIONAL]

# ============================================================
# CREDENTIALS
# ============================================================
# Gateway operator credential. Required for every /api/v1/admin/* endpoint.
# There is NO unauthenticated development fallback, and the API refuses to start
# without it in production.
ADMIN_API_KEY=                              # [REQUIRED IN PRODUCTION]
# Accepted alias for the same operator credential (either name may be used):
YOUPI_ADMIN_API_KEY=                        # [OPTIONAL ALIAS]

# Merchant service credential used by merchant backends to create payments and
# read payment status. Payment creation FAILS CLOSED without a credential.
# The demo merchant is seeded with a generated key when this is unset; retrieve it
# from the database or rotate it through the authenticated admin API.
MERCHANT_API_KEY=                           # [OPTIONAL]
# Accepted aliases:
YOUPI_MERCHANT_API_KEY=                     # [OPTIONAL ALIAS]
OPENUPI_MERCHANT_API_KEY=                   # [OPTIONAL ALIAS]

# Secret-vault key protecting observer credentials and device signing keys AT REST
# (AES-256-GCM). 64 hex chars, base64, or a strong passphrase. The API refuses to
# start in production without it.
YOUPI_SECRET_KEY=                           # [REQUIRED IN PRODUCTION]
# Accepted alias:
OPENUPI_SECRET_KEY=                         # [OPTIONAL ALIAS]
# Rotation staging: set to the PREVIOUS key material while rotating so sealed
# values can still be opened (and are re-sealed on their next write).
YOUPI_SECRET_KEY_PREVIOUS=                  # [OPTIONAL, ROTATION ONLY]

# Dedicated observer credential used by the SMS/Gmail observer processes.
# Format: <keyId>.<secret> — issued once by
# POST /api/v1/admin/observers/credentials (rotate/revoke through the admin API).
# Observer ingest rejects merchant and admin API keys.
YOUPI_OBSERVER_CREDENTIAL=                  # [REQUIRED FOR OBSERVER APPS]

# ============================================================
# TIMING & QUEUE ENGINE
# ============================================================
PAYMENT_ACTIVE_WINDOW_MS=300000             # [OPTIONAL]
PAYMENT_PROCESSING_WINDOW_MS=30000          # [OPTIONAL]
# Independent-corroboration window. Corroboration NEVER settles a payment on its
# own: SUCCESS requires an authenticated bank/acquirer confirmation.
PAYMENT_GRACE_PERIOD_MS=1800000             # [OPTIONAL]

# ============================================================
# OBSERVERS
# ============================================================
# Gmail observer OAuth client credentials (never returned in API responses).
GMAIL_CLIENT_ID=                            # [OPTIONAL]
GMAIL_CLIENT_SECRET=                        # [OPTIONAL]
GMAIL_POLL_INTERVAL_MS=5000                 # [OPTIONAL]
SMS_OBSERVER_POLL_INTERVAL_MS=3000          # [OPTIONAL]
# Legacy DOM-scraping observers stay disabled unless explicitly enabled.
ENABLE_LEGACY_CHROME_OBSERVERS=false        # [OPTIONAL]

# ============================================================
# WEBHOOK DELIVERY (durable transactional outbox)
# ============================================================
WEBHOOK_MAX_RETRIES=5                       # [OPTIONAL]
WEBHOOK_WORKER_INTERVAL_MS=5000             # [OPTIONAL]

# ============================================================
# DEMO WALLET STORE
# ============================================================
COIN_STORE_WEBHOOK_URL=http://localhost:5000/api/webhook   # [OPTIONAL]
COIN_STORE_WEBHOOK_SECRET=                  # [OPTIONAL]

# ============================================================
# TUNNEL (optional; operator-configured binary only)
# ============================================================
# Arbitrary commands are never executed from the API. To let the gateway manage a
# tunnel it must be given an absolute path to a known binary plus its arguments.
CLOUDFLARE_TUNNEL_BIN=                      # [OPTIONAL]
CLOUDFLARE_TUNNEL_ARGS=tunnel --no-autoupdate run   # [OPTIONAL]
CLOUDFLARE_DOMAIN=                          # [OPTIONAL]
DEPLOYMENT_PREFIX=                          # [OPTIONAL]

# ============================================================
# BRANDING DEFAULTS
# ============================================================
DEFAULT_APP_NAME="OpenUPI"                  # [OPTIONAL]
DEFAULT_PRIMARY_COLOR="#2563eb"             # [OPTIONAL]
DEFAULT_SUPPORT_EMAIL="support@openupi.local"   # [OPTIONAL]

# ============================================================
# TEST HARNESS ONLY (never set in production)
# ============================================================
TEST_MERCHANT_API_KEY=                      # [TEST ONLY]
