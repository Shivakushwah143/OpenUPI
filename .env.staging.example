# ============================================================
# YOUPI PG V2 — STAGING environment template
# ============================================================
# Copy to `.env.staging` (git-ignored) and fill in every REQUIRED value:
#   cp .env.staging.example .env.staging
#   chmod 600 .env.staging
#
# Used by docker-compose.staging.yml:
#   docker compose --env-file .env.staging -f docker-compose.staging.yml up -d
# (compose reads `.env.staging` through each service's env_file, so no values
#  need to be exported into the host shell.)
#
# Generate strong secrets:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================

# --- RUNTIME ---
NODE_ENV=production
# Drives server-side URL derivation (pairing QR + API responses). `production`
# makes the pairing QR point at the public HTTPS API host.
YOUPI_MODE=production
# Bare domain used to derive https://<prefix>.<domain> and https://<prefix>-api.<domain>.
# Despite the legacy name, this is the runtime domain for both Cloudflare and
# host-Nginx deployments.
CLOUDFLARE_DOMAIN=staging.example.com
DEPLOYMENT_PREFIX=pay

# --- PUBLIC URLS (must match the Nginx server_name + TLS certificate) ---
BASE_CHECKOUT_URL=https://pay.staging.example.com
BASE_PAYMENT_API_URL=https://pay-api.staging.example.com
# Container-to-container API address. Compose also sets this per service; keeping
# it here documents the contract for any future service added to the stack.
PAYMENT_API_INTERNAL_URL=http://payment-api:6100

# --- SERVICE PORTS (container-internal defaults; host binds are loopback-only) ---
PAYMENT_API_PORT=6100
CHECKOUT_PORTAL_PORT=7000
MERCHANT_ADMIN_PORT=6001

# --- STORAGE ---
# Compose mounts the named volume `youpi-data` at /data and pins this path.
SQLITE_DB_PATH=/data/youpi.sqlite
# Never enable this on staging unless you intentionally want to rebuild legacy
# customer identity tables (destroys data). Back up first.
ALLOW_DESTRUCTIVE_MIGRATION=false

# --- CREDENTIALS (REQUIRED) ---
# Blank values fail closed: the API refuses to start in production until set.
# Operator credential for /api/v1/admin/*. Generate 64 hex chars.
ADMIN_API_KEY=
# Merchant credential for payment creation/status. Generate a separate value.
# Keeping this set means the seeded merchant key is known and stable.
MERCHANT_API_KEY=
# AES-256-GCM vault key protecting observer/device secrets at rest. REQUIRED.
# 64 hex chars (or a strong base64/passphrase). Rotate with YOUPI_SECRET_KEY_PREVIOUS.
YOUPI_SECRET_KEY=
# Optional rotation window only:
YOUPI_SECRET_KEY_PREVIOUS=

# Dedicated observer credential for the Node SMS/Gmail observers. NOT required for
# the Android APK, which enrolls with a single-use pairing token.
YOUPI_OBSERVER_CREDENTIAL=

# --- PAYMENT TIMING ---
PAYMENT_ACTIVE_WINDOW_MS=300000
PAYMENT_PROCESSING_WINDOW_MS=30000
PAYMENT_GRACE_PERIOD_MS=1800000

# --- WEBHOOK OUTBOX ---
WEBHOOK_MAX_RETRIES=5
WEBHOOK_WORKER_INTERVAL_MS=5000

# --- OPTIONAL SERVICES: DISABLED FOR THE FIRST STAGING TEST ---
# No browser automation, Gmail polling, demo store, or WhatsApp session is started.
ENABLE_LEGACY_CHROME_OBSERVERS=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
COIN_STORE_WEBHOOK_URL=
COIN_STORE_WEBHOOK_SECRET=

# --- BRANDING (leave defaults; do not rebrand for the staging test) ---
DEFAULT_APP_NAME=OpenUPI
DEFAULT_PRIMARY_COLOR="#2563eb"
DEFAULT_SUPPORT_EMAIL=support@openupi.local

# --- OpenUPI admin (published at https://admin.169.58.29.37.sslip.io) -------
OPENUPI_ADMIN_PORT=6200
OPENUPI_ADMIN_USERNAME=admin
# scrypt hash; generate on the VPS with:
#   node -e "import('./apps/openupi-admin/src/config.js').then(m => console.log(m.hashPassword('your-strong-password')))"
OPENUPI_ADMIN_PASSWORD_HASH=
OPENUPI_ADMIN_SESSION_TTL_MINUTES=480
OPENUPI_ADMIN_SESSION_SECRET=
OPENUPI_ADMIN_COOKIE_SECURE=1
OPENUPI_ADMIN_TRUST_PROXY=1
OPENUPI_ADMIN_PUBLIC_ORIGIN=https://admin.169.58.29.37.sslip.io
OPENUPI_CHECKOUT_INTERNAL_URL=http://checkout-portal:7000
